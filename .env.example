# REQUIRED when Artha is reachable from another device. Long random string, e.g. `openssl rand -hex 24`.
# Without it, the API only answers requests from the server itself.
ARTHA_TOKEN=change-me-to-a-long-random-string
# Optional: a second token that can ONLY add payments via /api/sms. Put this one in MacroDroid etc.
ARTHA_WEBHOOK_TOKEN=
# Optional: enables AI features (receipt scanning, voice/free-form entry, questions, monthly insights).
# They are still off until you switch them on in Settings.
ANTHROPIC_API_KEY=
# Optional: Claude model used for AI features
ARTHA_MODEL=claude-opus-5-5
# Where the SQLite database lives
ARTHA_DB=./data/artha.db
# Your timezone, so "today" is correct even if the server runs on UTC
ARTHA_TZ=Asia/Kolkata
